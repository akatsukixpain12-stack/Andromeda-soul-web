rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile matching
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Knowledge sub-collection
      match /knowledge/{knowledgeId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(knowledgeId);
      }

      // Conversations sub-collection
      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);

        // Messages sub-collection
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
          allow create, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }
    }

    // Collective Knowledge Collection (Learned insights stored on Google Cloud server)
    match /collective_knowledge/{knowledgeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(knowledgeId);
      allow update: if isSignedIn() && isValidId(knowledgeId);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
